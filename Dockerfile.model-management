# Reuse the verified runtime while dependencies and Linux signer code are unchanged.
# Rebuild Dockerfile.deployment when those change before selecting a new BASE_IMAGE.
ARG BASE_IMAGE=aistudio-api:source-d4ddd0984b15
FROM ${BASE_IMAGE}
ARG UPSTREAM_REVISION=d4c3b7957ce491e820f4c774e741c2194b5c45b5
ARG CUSTOM_BUILD=upstream-d4c3b-20261116
ENV AISTUDIO_UPSTREAM_REVISION=${UPSTREAM_REVISION} \
    AISTUDIO_CUSTOM_BUILD=${CUSTOM_BUILD}
LABEL org.opencontainers.image.source="https://github.com/DeconstructedCube/aistudio-api" \
    org.opencontainers.image.revision=${UPSTREAM_REVISION} \
    local.aistudio.custom-build=${CUSTOM_BUILD}
COPY src/ /app/src/
COPY main.py /app/main.py
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -fsS http://localhost:8080/health || exit 1
